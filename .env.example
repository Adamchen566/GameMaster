# Copy this file to .env for `docker compose up`. Never commit .env.
# These are local-only example values, not real credentials.

# PostgreSQL (required by compose.yaml). Compose builds the API's DATABASE_URL
# from these; keep the password free of URL-special characters such as @ : / %.
POSTGRES_USER=avalon
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=avalon

# Host ports (optional; change one if it is already in use)
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=5173

# Base URL the browser uses to reach the API. `/api` goes through the Vite
# proxy, so the page and the API share an origin.
VITE_API_BASE_URL=/api

# AI players and the AI game master (optional). Each key turns one model on;
# every AI turn with it is a paid API call. Without keys the seats are bots.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# API logs: one JSON object per line (default), or "text" to read them in a terminal.
LOG_FORMAT=json
