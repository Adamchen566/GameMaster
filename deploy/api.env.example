# /opt/avalon/api.env: read by avalon-api.service. Owned by root, readable by the avalon group only.
DATABASE_URL=sqlite:////opt/avalon/data/avalon.db
AUTO_MIGRATE=true
LOG_FORMAT=json

# Only DeepSeek may play seats here: the local clients (Claude Code, Codex) are not on the server.
LLM_DRIVERS=deepseek
# Put the key here yourself, then: sudo systemctl restart avalon-api
DEEPSEEK_API_KEY=

# Anyone on the internet can open games. These bound the bill.
LLM_MAX_TOKENS_PER_GAME=200000
LLM_MAX_TOKENS_PER_DAY=2000000
