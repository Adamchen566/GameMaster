# Copy to apps/api/.env to give the API its model keys. Never commit .env.
# Leave a key empty and that model simply shows as unavailable in the lobby.

# Claude seats and the AI game master (paid per call).
# ANTHROPIC_API_KEY=

# DeepSeek seats and the AI game master (paid per call).
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Claude Code on this computer needs no key: install it and log in once (`claude`),
# and it shows up in the lobby. It uses that subscription and is slow (10s-2min a turn).
# CLAUDE_CODE_MODEL=sonnet

# Codex on this computer (the OpenAI desktop app or CLI) needs no key either: log in
# with ChatGPT once and it shows up. It uses that subscription, a few seconds a turn.
# CODEX_MODEL=

# Which ways of reaching a model to offer: auto (whatever is set up), none,
# or a comma list of claude, deepseek, claude_code, codex.
# LLM_DRIVERS=auto
